#!/bin/bash
#SBATCH --job-name=arthoi_pipeline
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --time=2-00:00:00

set -euo pipefail

: "${PROJECT_ROOT:?Set PROJECT_ROOT to the migrated ArtHOI_git directory}"
: "${VIDEO:?Set VIDEO to the input video path}"

cd "$PROJECT_ROOT"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export TOKENIZERS_PARALLELISM=false

python run_pipeline.py \
  --video "$VIDEO" \
  --seq-name "${SEQ_NAME:-sequence}" \
  --part-cnt "${PART_CNT:-2}" \
  --cano-frame "${CANO_FRAME:-0}" \
  --main-env "${ARTHOI_ENV:-arthoi}" \
  --asr-env "${ARTHOI_ASR_ENV:-arthoi}"
